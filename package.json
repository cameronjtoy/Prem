{
  "name": "prem",
  "productName": "Prem",
  "desktopName": "prem.desktop",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "An open-source lab notebook that runs on your own machines: protocols, runs, samples and signed records, in plain files.",
  "author": "Prem contributors",
  "homepage": "https://cameronjtoy.github.io/Prem/",
  "main": "./out/main/index.js",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cameronjtoy/Prem.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "lint": "oxlint src scripts build e2e *.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "server:build": "vite build --config vite.server.config.ts",
    "server": "npm run server:build && node out/server/index.js",
    "notices": "node scripts/third-party-notices.mjs",
    "package": "npm run build && npm run notices && electron-builder",
    "package:dir": "npm run build && npm run notices && electron-builder --dir",
    "site": "node scripts/build-site.mjs",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.4",
    "@lezer/markdown": "^1.7.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "chokidar": "^5.0.0",
    "dompurify": "^3.4.16",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "katex": "^0.18.9",
    "marked": "^18.0.14",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-force-graph-2d": "^1.29.1",
    "react-resizable-panels": "^4.14.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
